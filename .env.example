# JIRA Configuration
# The base URL of your Jira instance (without trailing slash)
# Example: https://your-company.atlassian.net
JIRA_URL=https://your-jira-instance.atlassian.net

# Jira username (usually your email address)
JIRA_USERNAME=your-email@example.com

# Jira API token (generate from: https://id.atlassian.com/manage-profile/security/api-tokens)
# DO NOT commit this file with real credentials!
JIRA_API_TOKEN=your_api_token_here

# JIRA Project Configuration
# Name of the Jira project to create
JIRA_PROJECT_NAME=Mitre Attack Framework

# Project key (short identifier, uppercase, e.g., 'ATTACK')
JIRA_PROJECT_KEY=ATTACK

# MITRE ATT&CK Configuration
# API endpoint for MITRE ATT&CK data (optional - uses default if not set)
# Default: https://raw.githubusercontent.com/mitre/cti/master/
MITRE_API_ENDPOINT=

# Application Settings
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, console
LOG_FORMAT=console

# Environment: development, staging, production
ENVIRONMENT=development

# SSL Verification
# Set to 'false' to disable SSL verification (not recommended for production)
SSL_VERIFY=true

# Application Behavior
# Hide techniques with 'Not Tracked' maturity in export
HIDE_NOT_TRACKED=false

# Maximum number of retries for API calls
MAX_RETRIES=3

# Timeout for API calls in seconds
REQUEST_TIMEOUT=30
